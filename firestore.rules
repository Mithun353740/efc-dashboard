rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == "mithun47490@gmail.com";
    }

    function isAdmin() {
      return isSuperAdmin() || 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
             (exists(/databases/$(database)/documents/sessions/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.role == 'admin');
    }

    function getSessionPlayerId() {
      return get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.playerId;
    }

    // ===============================================================
    // PRODUCTION RULES - Optimized for 50k daily reads
    // Read Budget: ~6,500 reads/day (87% under budget)
    // ===============================================================

    match /sessions/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if isAuthenticated() && request.auth.uid == uid;
    }

    match /admins/{uid} {
      allow read: if true;
      allow write: if isSuperAdmin() || (
        request.auth.uid == uid && 
        exists(/databases/$(database)/documents/players/$(request.resource.data.playerId)) && 
        get(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.role == 'admin'
      ) || (
        request.auth.uid == uid && request.resource.data.type == 'master'
      );
    }

    // PRE-COMPUTED SNAPSHOTS (Public read, Admin write)
    match /settings/appSnapshot {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /settings/clubSnapshot {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isAuthenticated() && 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['image', 'device', 'uid', 'email', 'password']));
    }

    match /leaders/{leaderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated();
    }

    match /settings/version {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /settings/locks {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /settings/locks/{lockId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /settings/clubConfig {
      allow read: if true;
      allow write: if isAdmin() || 
                    (isAuthenticated() && 
                     (
                       (resource != null && getSessionPlayerId() == resource.data.auctionAdminId) ||
                       (request.resource != null && getSessionPlayerId() == request.resource.data.auctionAdminId)
                     )
                    );
    }
    
    match /settings/meta {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /clubListings/{listingId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /auctions/{auctionId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /clubInbox/{ownerId} {
      allow read: if request.auth != null && (request.auth.uid == ownerId || isAdmin());
      allow write: if isAuthenticated();
    }

    match /transferThreads/{threadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    match /clubSeasons/{seasonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clubFixtures/{fixtureId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /clubTournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
